# ===== 测试环境配置（test 分支使用，可提交到 git）=====
# 对应 docker-compose.yml：后端 3001、数据库 smart_task_board_test

NODE_ENV=development

# 数据库连接：compose 内服务名 db，测试库独立，避免污染生产数据
DATABASE_URL=postgresql://postgres:postgres@db:5432/smart_task_board_test?schema=public

# JWT 密钥：测试用弱密钥即可，切勿与生产共用
JWT_ACCESS_SECRET=test-access-secret-change-me
JWT_REFRESH_SECRET=test-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 后端监听端口（容器内）
PORT=3001

# 测试环境放开 CORS，便于本地/预览联调
CORS_ORIGIN=

# 测试环境不强制 HTTPS
FORCE_HTTPS=false
