# 复制为 .env 使用（不要提交真实密钥）
# 本地 docker-compose 已用同名变量覆盖，这里主要给 Railway / 本地裸跑参考

JWT_ACCESS_SECRET="请替换为强随机值"
JWT_REFRESH_SECRET="请替换为强随机值"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# 本地
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_task_board?schema=public"
PORT=3001
CORS_ORIGIN=""

# 前端（Vercel 环境变量）
NEXT_PUBLIC_API_URL="https://你的后端域名.up.railway.app"
